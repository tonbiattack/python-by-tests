---
/** Pythonの最小コードとpytestの観測結果を並べる入口。 */
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeComparison from "../components/CodeComparison.astro";
import VersionBadge from "../components/VersionBadge.astro";
import { lessons, sourceCode, testCode } from "../data/lessons";
import { withBase } from "../lib/links";

const featured = lessons[0];
const lessonCount = String(lessons.length).padStart(2, "0");
---

<BaseLayout title="Pythonの挙動をpytestで確かめる" description="Pythonの見落としやすい挙動を、pytestと対になるソースコードで確認する学習サイト。">
  <section class="hero">
    <div>
      <p class="eyebrow">Python 3.13 / pytest</p>
      <h1>Pythonの挙動を、<br /><em>テストで</em>観測する。</h1>
      <p class="lede">説明より先に、実行できる境界条件を見る。Python by Tests は、Sourceとpytestを並べて読むためのExecutable Documentationです。</p>
      <div class="actions"><a class="primary" href={withBase(`python/${featured.slug}`)}>最初の観測を見る →</a><a href="#catalog">{lessons.length} lessons</a></div>
    </div>
    <figure class="proof-scene" aria-label="SourceとTestをつなぐ実行トレースの構成図"><span class="scene-file source-file">identity.py</span><span class="scene-file test-file">test_lessons.py</span><i class="scene-trace">→</i><div class="scene-grid"></div><figcaption>Source <b>→</b> pytest / observed</figcaption></figure>
  </section>
  <section class="method">
    <p class="eyebrow">The method</p><h2>仕様を暗記する前に、<br />テストの観測結果を読む。</h2>
    <div>{["Source|確認したい最小のPythonコードだけを置きます。","Test|pytestで、挙動をそのまま固定します。","Evidence|値、None、例外、参照共有を短い結果として残します。"].map((item,index)=>{const [title,text]=item.split("|");return <article><span>0{index+1}</span><h3>{title}</h3><p>{text}</p></article>})}</div>
  </section>
  <section class="featured"><header><div><p class="eyebrow">First observation</p><h2>{featured.title}</h2></div><VersionBadge version={featured.version} /></header><p class="section-lede">{featured.oneLine}</p><CodeComparison sourceFilename={featured.sourceFile} testFilename={featured.testFile} source={sourceCode(featured)} test={testCode(featured)} /></section>
  <section id="catalog" class="catalog"><header><div><p class="eyebrow">Initial catalog</p><h2>まずは、{lessons.length}個の確かな挙動から。</h2></div><span>{lessonCount} / {lessonCount}</span></header><div class="list">{lessons.map((lesson,index)=><a href={withBase(`python/${lesson.slug}`)}><b>{String(index+1).padStart(2,"0")}</b><div><small>{lesson.section}</small><h3>{lesson.title}</h3><em>Test {lesson.testName}</em></div><p>{lesson.oneLine}</p><VersionBadge version={lesson.version}/><i>→</i></a>)}</div></section>
</BaseLayout>

<style>
  /* Design system: パケット追跡の作業台 — the runnable code surface is the primary evidence object. */
  .hero,.method,.featured,.catalog { max-width: 90rem; margin: 0 auto; padding-right: clamp(1.25rem,4vw,4.5rem); padding-left: clamp(1.25rem,4vw,4.5rem); }.hero { display: grid; grid-template-columns: minmax(0,.88fr) minmax(23rem,1.12fr); min-height: min(42rem,78vh); align-items: center; gap: clamp(2.5rem,6vw,6.5rem); padding-top: clamp(4.5rem,9vw,9rem); padding-bottom: clamp(4.5rem,9vw,9rem); }h1 { max-width: 9.2ch; margin: 1rem 0 1.25rem; font-family: var(--display); font-size: clamp(3rem,5vw,5.6rem); font-weight: 600; letter-spacing: -.08em; line-height: .94; }h1 em { color: var(--green); font-style: normal; }.lede { max-width: 35rem; color: var(--muted); font-size: .98rem; }.actions { display: flex; align-items: center; gap: 1.1rem; margin-top: 2rem; }.actions a:not(.primary) { border-bottom: 1px solid var(--bright); color: var(--muted); font-family: var(--code); font-size: .72rem; }.primary { padding: .75rem .95rem; background: var(--green); color: #041215; font-family: var(--display); font-size: .84rem; font-weight: 700; transition: transform 160ms var(--ease),box-shadow 160ms var(--ease); }.primary:hover { box-shadow: 0 .5rem 1.6rem rgba(0,173,216,.2); transform: translateY(-2px); }.proof-scene { position: relative; min-height: 23rem; margin: 0; overflow: hidden; border: 1px solid var(--line); background: linear-gradient(135deg,#0f1a20,#0b1115); }.proof-scene:before,.proof-scene:after { position: absolute; top: 4.2rem; bottom: 3.7rem; width: 37%; border: 1px solid var(--bright); background: rgba(11,17,21,.75); content: ""; }.proof-scene:before { left: 7%; }.proof-scene:after { right: 7%; background: #0d202a; }.scene-grid { position: absolute; inset: 0; opacity: .34; background-image: linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size: 2rem 2rem; }.scene-file { position: absolute; z-index: 2; top: 3.1rem; color: var(--muted); font-family: var(--code); font-size: .63rem; }.source-file { left: 8%; }.test-file { right: 8%; color: var(--paper); }.scene-trace { position: absolute; z-index: 3; top: 50%; left: 50%; display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid var(--green); border-radius: 50%; background: var(--ink); color: var(--green); font-family: var(--code); font-style: normal; transform: translate(-50%,-50%); }.scene-trace:before,.scene-trace:after { position: absolute; top: 50%; width: 5rem; height: 1px; background: var(--green); content: ""; }.scene-trace:before { right: 100%; }.scene-trace:after { left: 100%; }.proof-scene figcaption { position: absolute; z-index: 2; right: 1rem; bottom: .9rem; color: var(--muted); font-family: var(--code); font-size: .62rem; letter-spacing: .045em; }.proof-scene figcaption b { color: var(--green); }.method { padding-top: 2rem; padding-bottom: 6.75rem; border-top: 1px solid var(--line); }h2 { margin: .75rem 0 0; font-family: var(--display); font-size: clamp(1.85rem,3vw,3rem); font-weight: 500; letter-spacing: -.065em; line-height: 1.06; }.method>div { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; margin-top: 2.6rem; border: 1px solid var(--line); background: var(--line); }.method article { padding: 1.15rem 1.25rem 1.35rem; background: var(--ink); }.method article>span { color: var(--dim); font-family: var(--code); font-size: .7rem; }.method h3 { margin: 1rem 0 .4rem; font-family: var(--display); font-size: 1rem; }.method p { margin: 0; color: var(--muted); font-size: .83rem; }.featured { padding-bottom: 6.75rem; }.featured header,.catalog header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }.section-lede { margin: 1.1rem 0 1.75rem; color: var(--muted); }.catalog { padding-top: 4.5rem; padding-bottom: 6rem; border-top: 1px solid var(--line); }.catalog header>span { color: var(--dim); font-family: var(--code); font-size: .72rem; }.list { margin-top: 2.4rem; border-top: 1px solid var(--line); }.list a { display: grid; grid-template-columns: 2.3rem minmax(13rem,1.15fr) minmax(15rem,1fr) auto 1.25rem; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); transition: background 160ms var(--ease),padding 160ms var(--ease); }.list a:hover { padding-right: .8rem; padding-left: .8rem; background: rgba(0,173,216,.06); }.list b,.list small,.list em { font-family: var(--code); }.list b,.list small { color: var(--dim); font-size: .68rem; }.list small { letter-spacing: .08em; text-transform: uppercase; }.list h3 { margin: .12rem 0 0; font-family: var(--display); font-size: .9rem; font-weight: 500; letter-spacing: -.025em; }.list em { display: block; margin-top: .22rem; color: var(--dim); font-size: .58rem; font-style: normal; }.list p { margin: 0; color: var(--muted); font-size: .78rem; }.list i { color: var(--green); font-family: var(--code); font-style: normal; }@media(max-width:960px){.hero{grid-template-columns:1fr}.proof-scene{max-width:46rem}}@media(max-width:720px){.method>div{grid-template-columns:1fr}.list a{grid-template-columns:1.8rem 1fr auto;gap:.7rem}.list p,.list .badge{display:none}.hero{min-height:auto;padding-top:4rem}}@media(max-width:440px){h1{font-size:3rem}.actions{align-items:flex-start;flex-direction:column}.scene-trace:before,.scene-trace:after{width:3.2rem}}
</style>
