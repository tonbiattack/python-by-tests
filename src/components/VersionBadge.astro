---
/** Design system: パケット追跡の作業台 — concise factual Go-version metadata. */
const {version}=Astro.props;
---
<span class="badge">{version}</span><style>/* Design system: パケット追跡の作業台 — rectangular monospace runtime badge. */.badge{display:inline-flex;padding:.22rem .42rem;border:1px solid rgba(0,173,216,.5);background:rgba(0,173,216,.07);color:var(--green);font-family:var(--code);font-size:.66rem;letter-spacing:.035em}</style>
