---
/** Design system: パケット追跡の作業台 — Go source and test evidence get equal-weight editor surfaces. */
import {codeToHtml} from "shiki";type Props={kind:"Source"|"Test";filename:string;code:string};const {kind,filename,code}=Astro.props;const html=await codeToHtml(code,{lang:"go",theme:"github-dark"});
---
<article class:list={["panel",kind.toLowerCase()]} data-code={code}><header><div><b>{kind}</b><span>{filename}</span></div><div><small>Go 1.22</small><button class="copy" type="button"><i>⧉</i> <em>Copy</em></button></div></header><div class="code" set:html={html}/></article><script>document.addEventListener("click",async e=>{const button=(e.target as HTMLElement).closest<HTMLButtonElement>(".copy");if(!button)return;const panel=button.closest<HTMLElement>("[data-code]");if(!panel?.dataset.code)return;try{await navigator.clipboard.writeText(panel.dataset.code);button.querySelector("em")!.textContent="Copied";setTimeout(()=>button.querySelector("em")!.textContent="Copy",1500)}catch{button.querySelector("em")!.textContent="Select"}})</script><style>/* Design system: パケット追跡の作業台 — file tabs and calm editor surfaces prioritize wrapped Go syntax. */.panel{min-width:0;overflow:hidden;background:var(--source)}.panel.test{background:var(--test)}.panel header{display:flex;min-height:3.45rem;align-items:center;justify-content:space-between;gap:.75rem;padding:0 .8rem 0 .95rem;border-bottom:1px solid var(--line);background:rgba(255,255,255,.018)}.panel header>div{display:flex;min-width:0;align-items:center;gap:.55rem}.panel b{padding:.12rem .33rem;border:1px solid var(--line);color:var(--muted);font-family:var(--code);font-size:.59rem;letter-spacing:.07em;text-transform:uppercase}.test b{border-color:rgba(0,173,216,.45);color:var(--green)}.panel span{overflow:hidden;font-family:var(--code);font-size:.77rem;text-overflow:ellipsis;white-space:nowrap}.panel small,.copy{color:var(--dim);font-family:var(--code);font-size:.58rem}.copy{border:0;background:transparent;cursor:pointer}.copy:hover{color:var(--green)}.copy em{font-style:normal}.code{max-width:100%;overflow:hidden}.code :global(pre){min-width:0;margin:0!important;padding:1.15rem 1.2rem 1.35rem!important;background:transparent!important;font-family:var(--code)!important;font-size:.78rem!important;line-height:1.82!important;tab-size:2;white-space:pre-wrap;overflow-wrap:anywhere;word-break:normal}.code :global(code){display:block;font-family:inherit!important;white-space:inherit}@media(max-width:560px){.panel small{display:none}.code :global(pre){padding:1rem!important;font-size:.73rem!important;line-height:1.76!important}}</style>
