---
/** Design system: 証明の作業台 — compact, factual source traceability. */
import {SOURCE_REPOSITORY} from "../data/lessons";const {path}=Astro.props;
---
<a class="github" href={`${SOURCE_REPOSITORY}/blob/main/examples/${path}`} target="_blank" rel="noreferrer">View source on GitHub ↗</a><style>/* Design system: 証明の作業台 — unobtrusive source-level link. */.github{padding-bottom:.12rem;border-bottom:1px solid rgba(182,240,74,.45);color:var(--muted);font-family:var(--code);font-size:.7rem}.github:hover{border-color:var(--green);color:var(--green)}</style>
